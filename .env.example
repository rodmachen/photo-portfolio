# Cloudinary credentials (required for build)
PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Note: PUBLIC_CLOUDINARY_API_KEY is deprecated — use CLOUDINARY_API_KEY.
# The loader accepts both during transition and emits a warning for the old name.
# Update your Vercel env vars to use CLOUDINARY_API_KEY.

# Deploy hook (used by the sync script — optional)
# VERCEL_DEPLOY_HOOK_URL=
