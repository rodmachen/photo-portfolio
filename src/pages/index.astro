---
import BaseLayout from '../layouts/BaseLayout.astro';
import AlbumCard from '../components/AlbumCard.astro';
import { getGalleryTree } from '../lib/site-tree';

const { tree } = await getGalleryTree();
const topLevel = tree.filter((n) => !n.hidden);
---

<BaseLayout>
  <section class="hero">
    <h1>Photography</h1>
    <p>by Rod Machen</p>
  </section>

  <section class="album-grid">
    {topLevel.map((node) => (
      <AlbumCard
        href={`/${node.path.join('/')}`}
        title={node.title}
        cover={node.cover}
        photoCount={node.photoCount}
      />
    ))}
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 3rem 0 4rem;
  }

  .hero h1 {
    font-size: 2.5rem;
    font-weight: 300;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .hero p {
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  .album-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 480px) {
    .album-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
